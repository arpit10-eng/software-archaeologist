SOFTWARE_ARCHAEOLOGIST_APP_NAME=Software Archaeologist
SOFTWARE_ARCHAEOLOGIST_APP_VERSION=2.1.0

# Environment
SOFTWARE_ARCHAEOLOGIST_ENVIRONMENT=development
SOFTWARE_ARCHAEOLOGIST_DEBUG=false

# Database
SOFTWARE_ARCHAEOLOGIST_DATABASE_URL=sqlite:///./software_archaeologist.db

# CORS
SOFTWARE_ARCHAEOLOGIST_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# GitHub API
SOFTWARE_ARCHAEOLOGIST_GITHUB_API_TIMEOUT=10

# Repository temporary storage
SOFTWARE_ARCHAEOLOGIST_REPOSITORY_STORAGE_PATH=temp